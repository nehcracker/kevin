{
  "name": "kevin-graham-profile",
  "version": "0.1.0",
  "private": true,
  "dependencies": {
    "@fortawesome/fontawesome-free": "^7.2.0",
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^13.5.0",
    "ajv": "^6.12.6",
    "ajv-keywords": "^3.5.2",
    "framer-motion": "^12.40.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "react-helmet-async": "^2.0.5",
    "react-router-dom": "^7.18.4",
    "react-scripts": "5.0.1",
    "swiper": "^12.2.0",
    "web-vitals": "^2.1.4"
  },
  "scripts": {
    "start": "react-scripts start",
    "prebuild": "node scripts/check-pfi-placeholders.js",
    "build": "react-scripts build",
    "postbuild": "node scripts/prerender-meta.js",
    "test": "react-scripts test",
    "test:workers": "node --test enquiry-shared/security.test.mjs",
    "deploy:pfi-enquiry": "wrangler deploy -c pfi-enquiry/wrangler.toml",
    "deploy:pf-enquiry": "wrangler deploy -c pf-enquiry/wrangler.toml",
    "export:enquiries": "node scripts/export-enquiries.mjs",
    "eject": "react-scripts eject"
  },
  "eslintConfig": {
    "extends": [
      "react-app",
      "react-app/jest"
    ]
  },
  "jest": {
    "moduleNameMapper": {
      "^react-router-dom$": "<rootDir>/node_modules/react-router-dom/dist/index.js",
      "^react-router/dom$": "<rootDir>/node_modules/react-router/dist/development/dom-export.js"
    }
  },
  "browserslist": {
    "production": [
      ">0.2%",
      "not dead",
      "not op_mini all"
    ],
    "development": [
      "last 1 chrome version",
      "last 1 firefox version",
      "last 1 safari version"
    ]
  },
  "overrides": {
    "svgo": {
      "nth-check": "2.1.1"
    },
    "resolve-url-loader": {
      "postcss": "8.4.45"
    },
    "react-helmet-async": {
      "react": "^19.1.0"
    }
  }
}
