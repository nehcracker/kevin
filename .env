# Build-time settings (no secrets — this file is committed).

# Emit the webpack runtime as a file instead of an inline <script>, so the
# Content-Security-Policy in public/_headers needs no 'unsafe-inline'.
INLINE_RUNTIME_CHUNK=false

# Don't publish source maps: they expose the full original source.
GENERATE_SOURCEMAP=false

# Cloudflare Turnstile site key (public — it is shipped in the page anyway).
# The matching secret is the Workers secret TURNSTILE_SECRET_KEY.
REACT_APP_TURNSTILE_SITE_KEY=0x4AAAAAAFYyky5Gwat4Xjf5
