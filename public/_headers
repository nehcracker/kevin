# Security headers for every response served by Cloudflare static assets.
# Copied to build/_headers by CRA and applied by Cloudflare at the edge.
#
# CSP allowlist — keep in step with what the site actually loads:
#   Google Ads gtag      www.googletagmanager.com, googleadservices, doubleclick, google.com
#                        + www.google.<ccTLD> for key markets: Google redirects
#                        conversion pings to the visitor's regional domain, and
#                        CSP checks redirect targets. Add a ccTLD if a market
#                        is missing (symptom: connect-src violations on /thank-you).
#   Trustpilot widget    widget.trustpilot.com
#   Google Fonts         fonts.googleapis.com (CSS), fonts.gstatic.com (fonts)
#   Enquiry Workers      pfi-enquiry / pf-enquiry .grahamkarimi.com (Worker custom domains)
#   Turnstile            challenges.cloudflare.com (bot check on enquiry forms)
# No 'unsafe-inline' / 'unsafe-eval' for scripts: gtag config lives in
# /gtag-init.js and the CRA runtime chunk is not inlined (see .env).
# style-src keeps 'unsafe-inline' because Trustpilot and Turnstile inject
# inline styles; script execution is still fully locked down.
#
# HSTS omits includeSubDomains until every subdomain (www, jobs, mail…)
# is confirmed HTTPS-only — then add "; includeSubDomains; preload".

/*
  Strict-Transport-Security: max-age=31536000
  Content-Security-Policy: default-src 'self'; script-src 'self' https://www.googletagmanager.com https://www.googleadservices.com https://*.doubleclick.net https://www.google.com https://widget.trustpilot.com https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' data: https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://pfi-enquiry.grahamkarimi.com https://pf-enquiry.grahamkarimi.com https://www.google.com https://google.com https://www.google.co.uk https://www.google.co.ke https://www.google.com.ng https://www.google.com.gh https://www.google.co.za https://www.google.co.ug https://www.google.co.tz https://www.google.com.et https://www.google.co.zw https://www.google.co.zm https://www.google.rw https://www.google.ae https://www.google.com.sa https://www.google.com.qa https://www.google.com.kw https://www.google.com.eg https://www.google.com.pk https://www.google.co.in https://www.google.ie https://www.google.fr https://www.google.de https://www.google.nl https://www.google.es https://www.google.it https://www.google.ch https://www.google.ca https://www.google.com.au https://www.googleadservices.com https://*.doubleclick.net https://*.google-analytics.com https://analytics.google.com https://*.analytics.google.com https://*.googletagmanager.com https://widget.trustpilot.com https://challenges.cloudflare.com; frame-src https://widget.trustpilot.com https://challenges.cloudflare.com https://*.doubleclick.net https://www.googletagmanager.com; frame-ancestors 'none'; base-uri 'self'; form-action 'self'; object-src 'none'; manifest-src 'self'; worker-src 'self'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: accelerometer=(), autoplay=(), camera=(), display-capture=(), encrypted-media=(), fullscreen=(self), geolocation=(), gyroscope=(), magnetometer=(), microphone=(), midi=(), payment=(), publickey-credentials-get=(), screen-wake-lock=(), usb=(), xr-spatial-tracking=()
  Cross-Origin-Opener-Policy: same-origin
  X-Permitted-Cross-Domain-Policies: none

# Content-hashed bundles never change — cache for a year.
/static/*
  Cache-Control: public, max-age=31536000, immutable
